# Mnemis API server image.
# Single-stage: Bun runs TypeScript natively, so we install deps and run
# directly from source. Production environments should mount a tagged build.
FROM oven/bun:1.3.1-alpine

WORKDIR /app

# Install workspace deps. The lockfile + workspace package.jsons are enough.
COPY package.json bun.lock turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/db/package.json packages/db/
COPY packages/embeddings/package.json packages/embeddings/
COPY packages/indexer/package.json packages/indexer/
COPY packages/sdk/package.json packages/sdk/

RUN bun install --frozen-lockfile --production

# Copy source. .dockerignore prunes node_modules / dist / .turbo so the
# install step's deps are not overwritten.
COPY apps/api ./apps/api
COPY packages/db ./packages/db
COPY packages/embeddings ./packages/embeddings
COPY packages/indexer ./packages/indexer
COPY packages/sdk ./packages/sdk

ENV NODE_ENV=production
ENV API_HOST=0.0.0.0
EXPOSE 8787

HEALTHCHECK --interval=15s --timeout=5s --retries=4 \
  CMD wget -qO- http://localhost:8787/health > /dev/null 2>&1 || exit 1

CMD ["bun", "run", "apps/api/src/index.ts"]
