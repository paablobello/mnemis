FROM oven/bun:1.3.1-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /app

COPY package.json bun.lock turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/cli/package.json apps/cli/
COPY apps/mcp/package.json apps/mcp/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/db/package.json packages/db/
COPY packages/embeddings/package.json packages/embeddings/
COPY packages/eval/package.json packages/eval/
COPY packages/indexer/package.json packages/indexer/
COPY packages/saas/package.json packages/saas/
COPY packages/sdk/package.json packages/sdk/

RUN bun install --frozen-lockfile

COPY apps/worker ./apps/worker
COPY packages/db ./packages/db
COPY packages/embeddings ./packages/embeddings
COPY packages/indexer ./packages/indexer

RUN bun --filter @mnemis/worker build

FROM oven/bun:1.3.1-alpine AS runtime

RUN apk add --no-cache git ca-certificates && addgroup -S mnemis && adduser -S mnemis -G mnemis

WORKDIR /app

COPY --from=builder /app/apps/worker/dist ./apps/worker/dist

ENV NODE_ENV=production

USER mnemis

CMD ["bun", "run", "apps/worker/dist/index.js"]
