{
  "name": "@mnemis/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "bun run pre-migrate && drizzle-kit migrate && bun run post-migrate",
    "push": "bun run pre-migrate && drizzle-kit push && bun run post-migrate",
    "push:ci": "bun run pre-migrate && drizzle-kit push --force && bun run post-migrate",
    "pre-migrate": "node --experimental-strip-types scripts/run-sql-dir.ts pre",
    "post-migrate": "node --experimental-strip-types scripts/run-sql-dir.ts post",
    "bootstrap": "node --experimental-strip-types scripts/bootstrap.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.3"
  }
}
