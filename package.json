{
  "name": "mnemis",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source memory and context platform for AI agents",
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "services/*"],
  "packageManager": "bun@1.3.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "bun --filter @mnemis/db generate",
    "db:migrate": "bun --filter @mnemis/db migrate",
    "db:push": "bun --filter @mnemis/db push",
    "db:push:ci": "bun --filter @mnemis/db push:ci",
    "db:studio": "bun --filter @mnemis/db studio",
    "db:bootstrap": "bun --filter @mnemis/db bootstrap",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "api:dev": "bun --filter @mnemis/api dev",
    "worker:dev": "bun --filter @mnemis/worker dev",
    "mcp:dev": "bun --filter @mnemis/mcp dev",
    "cli": "bun --filter @mnemis/cli start",
    "test:local": "DATABASE_URL=postgres://mnemis:mnemis_dev@localhost:5433/mnemis INTERNAL_AUTH_SECRET=test-secret MNEMIS_ALLOW_LOCAL_SOURCES=true bun run test",
    "qa:research:smoke": "bun --env-file=.env scripts/research-live-smoke.ts",
    "qa:research:deep": "bun --env-file=.env scripts/research-deep-qa.ts",
    "qa:mcp-live": "bun --env-file=.env scripts/mcp-live-smoke.ts",
    "benchmark": "bun --filter @mnemis/eval benchmark"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "js-cookie": "^3.0.7",
    "postcss": "^8.5.10"
  }
}
