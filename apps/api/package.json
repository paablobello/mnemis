{
  "name": "@mnemis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js && tsc --noEmit",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@mnemis/db": "workspace:*",
    "@mnemis/embeddings": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.10",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@mnemis/eval": "workspace:*",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
