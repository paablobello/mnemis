{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "API_PORT",
    "API_HOST",
    "ANTHROPIC_API_KEY",
    "VOYAGE_API_KEY",
    "COHERE_API_KEY",
    "INTERNAL_AUTH_SECRET",
    "LOG_LEVEL",
    "MNEMIS_ALLOW_LOCAL_SOURCES"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
