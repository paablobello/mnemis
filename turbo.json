{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "API_PORT",
    "API_HOST",
    "ANTHROPIC_API_KEY",
    "VOYAGE_API_KEY",
    "COHERE_API_KEY",
    "FIRECRAWL_API_KEY",
    "FIRECRAWL_API_URL",
    "INTERNAL_AUTH_SECRET",
    "LOG_LEVEL",
    "MNEMIS_MODE",
    "MNEMIS_ALLOW_LOCAL_SOURCES",
    "MNEMIS_LOCAL_SOURCE_ROOTS",
    "MNEMIS_MAX_BODY_BYTES",
    "MNEMIS_RATE_LIMIT_PER_MINUTE",
    "MNEMIS_RERANK_PROVIDER",
    "MNEMIS_RERANK_MODEL",
    "MNEMIS_LOCAL_RERANK_MODEL",
    "MNEMIS_PROVIDER_TIMEOUT_MS",
    "MNEMIS_FETCH_TIMEOUT_MS",
    "MNEMIS_GIT_TIMEOUT_MS",
    "ANTHROPIC_CONTEXT_MODEL",
    "WORKER_POLL_INTERVAL_MS",
    "JOB_STALE_AFTER_MS",
    "JOB_MAX_ATTEMPTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
