{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "API_PORT",
    "API_HOST",
    "MNEMIS_VERSION",
    "ANTHROPIC_API_KEY",
    "MNEMIS_CONTEXTUAL_PREFIX_CONCURRENCY",
    "VOYAGE_API_KEY",
    "COHERE_API_KEY",
    "FIRECRAWL_API_KEY",
    "FIRECRAWL_API_URL",
    "TAVILY_API_KEY",
    "MNEMIS_TAVILY_API_KEY",
    "EXA_API_KEY",
    "MNEMIS_EXA_API_KEY",
    "BRAVE_SEARCH_API_KEY",
    "MNEMIS_BRAVE_SEARCH_API_KEY",
    "SEMANTIC_SCHOLAR_API_KEY",
    "OPENALEX_EMAIL",
    "MNEMIS_RESEARCH_TIMEOUT_MS",
    "MNEMIS_PDF_EXTRACTOR_URL",
    "MNEMIS_PDF_EXTRACTOR_TIMEOUT_MS",
    "MNEMIS_PDF_NATIVE_MIN_CHARS",
    "PDF_EXTRACTOR_MAX_BYTES",
    "PDF_EXTRACTOR_ENABLE_GROBID",
    "PDF_EXTRACTOR_GROBID_URL",
    "PDF_EXTRACTOR_GROBID_TIMEOUT_SECONDS",
    "GROBID_IMAGE",
    "INTERNAL_AUTH_SECRET",
    "LOG_LEVEL",
    "MNEMIS_MODE",
    "MNEMIS_ALLOW_LOCAL_SOURCES",
    "MNEMIS_LOCAL_SOURCE_ROOTS",
    "MNEMIS_MAX_BODY_BYTES",
    "MNEMIS_RATE_LIMIT_PER_MINUTE",
    "MNEMIS_RATE_LIMIT_BACKEND",
    "MNEMIS_TRUST_PROXY",
    "MNEMIS_RERANK_PROVIDER",
    "MNEMIS_RERANK_MODEL",
    "MNEMIS_LOCAL_RERANK_MODEL",
    "MNEMIS_PROVIDER_TIMEOUT_MS",
    "MNEMIS_FETCH_TIMEOUT_MS",
    "MNEMIS_GIT_TIMEOUT_MS",
    "ANTHROPIC_CONTEXT_MODEL",
    "WORKER_POLL_INTERVAL_MS",
    "WORKER_ONCE",
    "JOB_STALE_AFTER_MS",
    "JOB_MAX_ATTEMPTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
