# Mnemis production environment (used by docker/docker-compose.prod.yml).
# Copy to .env.prod and edit before running:
#   docker compose -f docker/docker-compose.prod.yml --env-file .env.prod up -d

# --- Postgres ---
POSTGRES_USER=mnemis
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=mnemis

# --- API exposure ---
API_PORT=8787
MNEMIS_VERSION=

# --- Hosted dashboard (Vercel/Next.js) ---
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_MNEMIS_API_URL=https://api.example.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# --- Internal auth (must be unique per deployment) ---
# Changing this invalidates existing API keys.
INTERNAL_AUTH_SECRET=please-rotate-this-secret

# --- Optional integrations ---
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_CONTEXT_MODEL=
MNEMIS_CONTEXTUAL_PREFIX_CONCURRENCY=4
VOYAGE_API_KEY=
COHERE_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
TAVILY_API_KEY=
MNEMIS_TAVILY_API_KEY=
EXA_API_KEY=
MNEMIS_EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
MNEMIS_BRAVE_SEARCH_API_KEY=
# Optional. Without a key Semantic Scholar can return 429; OpenAlex remains the
# primary fallback when OPENALEX_EMAIL is set.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=
MNEMIS_RESEARCH_TIMEOUT_MS=20000
# Set to http://pdf-extractor:8790/extract only when running the Compose
# production stack with --profile pdf. Leave empty otherwise.
MNEMIS_PDF_EXTRACTOR_URL=
MNEMIS_PDF_EXTRACTOR_TIMEOUT_MS=180000
MNEMIS_PDF_NATIVE_MIN_CHARS=1500
PDF_EXTRACTOR_MAX_BYTES=52428800
PDF_EXTRACTOR_ENABLE_GROBID=true
PDF_EXTRACTOR_GROBID_URL=http://grobid:8070
PDF_EXTRACTOR_GROBID_TIMEOUT_SECONDS=120
# Use grobid/grobid:0.9.0-full for highest accuracy if you can afford the RAM/GPU.
GROBID_IMAGE=grobid/grobid:0.9.0-crf

# --- Retrieval tuning ---
# Provider: leave empty to use BM25+vector RRF only, or set 'voyage' / 'local'.
MNEMIS_RERANK_PROVIDER=
MNEMIS_RERANK_MODEL=rerank-2.5
# Override the local cross-encoder model id when MNEMIS_RERANK_PROVIDER=local.
MNEMIS_LOCAL_RERANK_MODEL=
MNEMIS_PROVIDER_TIMEOUT_MS=30000
MNEMIS_FETCH_TIMEOUT_MS=15000
MNEMIS_GIT_TIMEOUT_MS=300000

# --- Security guardrails ---
MNEMIS_MAX_BODY_BYTES=1000000
MNEMIS_RATE_LIMIT_PER_MINUTE=
MNEMIS_FREE_MONTHLY_CREDITS=10000
MNEMIS_ENFORCE_CREDITS=
MNEMIS_RATE_LIMIT_BACKEND=
MNEMIS_TRUST_PROXY=false

# Local source paths are dangerous on hosted/cloud deployments. Keep disabled
# unless this is a trusted single-tenant self-host.
MNEMIS_ALLOW_LOCAL_SOURCES=false
MNEMIS_LOCAL_SOURCE_ROOTS=

# --- Worker ---
WORKER_POLL_INTERVAL_MS=1000
JOB_STALE_AFTER_MS=1800000
JOB_MAX_ATTEMPTS=3

# --- Misc ---
LOG_LEVEL=info
MNEMIS_MODE=self-host
