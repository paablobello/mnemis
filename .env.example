# --- Database ---
DATABASE_URL=postgres://mnemis:mnemis_dev@localhost:5433/mnemis

# --- API server ---
API_PORT=8787
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- GitHub webhooks ---
GITHUB_WEBHOOK_SECRET=

# --- GitHub App (optional; required to index private repos) ---
# Numeric App ID from the GitHub App settings page.
GITHUB_APP_ID=
# PKCS#8 PEM private key downloaded from the GitHub App. Either inline (with
# literal \n line breaks) or paste the full PEM between double quotes.
GITHUB_APP_PRIVATE_KEY=

# --- LLM providers ---
# Anthropic (Contextual Retrieval + optional response synthesis)
ANTHROPIC_API_KEY=
# Optional override. Default: claude-3-5-haiku-latest
ANTHROPIC_CONTEXT_MODEL=

# Voyage AI (embeddings: voyage-3.5-large + voyage-code-3)
VOYAGE_API_KEY=

# Reserved for future reranking integrations.
COHERE_API_KEY=

# --- Internal auth (used to derive API key hashes) ---
INTERNAL_AUTH_SECRET=change-me-in-production

# --- Self-host vs cloud mode ---
MNEMIS_MODE=self-host

# Disabled by default because it lets API users ask the worker to read local
# paths from the server filesystem. Enable only for trusted local development.
MNEMIS_ALLOW_LOCAL_SOURCES=false
