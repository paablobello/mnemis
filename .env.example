# --- Database ---
DATABASE_URL=postgres://mnemis:mnemis_dev@localhost:5433/mnemis

# --- API server ---
API_PORT=8787
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
MNEMIS_VERSION=

# --- GitHub webhooks ---
GITHUB_WEBHOOK_SECRET=

# --- GitHub App (optional; required to index private repos) ---
# Numeric App ID from the GitHub App settings page.
GITHUB_APP_ID=
# PKCS#8 PEM private key downloaded from the GitHub App. Either inline (with
# literal \n line breaks) or paste the full PEM between double quotes.
GITHUB_APP_PRIVATE_KEY=

# --- LLM providers ---
# Anthropic (Contextual Retrieval + optional response synthesis)
ANTHROPIC_API_KEY=
# Optional override. Default: claude-3-5-haiku-latest
ANTHROPIC_CONTEXT_MODEL=
# Contextual Retrieval prefix generation is concurrent but bounded.
MNEMIS_CONTEXTUAL_PREFIX_CONCURRENCY=4

# Voyage AI (embeddings: voyage-3.5-large + voyage-code-3; optional rerank)
VOYAGE_API_KEY=

# Optional reranking. Leave unset to skip reranking.
MNEMIS_RERANK_PROVIDER=
MNEMIS_RERANK_MODEL=rerank-2.5
MNEMIS_LOCAL_RERANK_MODEL=

# Network/provider timeouts.
MNEMIS_PROVIDER_TIMEOUT_MS=30000
MNEMIS_FETCH_TIMEOUT_MS=15000
MNEMIS_GIT_TIMEOUT_MS=300000

# Firecrawl docs crawler. Leave unset to use the native crawler.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2

# --- Research discovery ---
# Web search providers. Configure at least one for live web research.
TAVILY_API_KEY=
MNEMIS_TAVILY_API_KEY=
EXA_API_KEY=
MNEMIS_EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
MNEMIS_BRAVE_SEARCH_API_KEY=

# Academic discovery providers. OpenAlex works best with your contact email.
# Semantic Scholar is optional; without a key it can return 429 and Mnemis will
# degrade through OpenAlex/arXiv/Crossref where available.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=

# Per-provider research request timeout.
MNEMIS_RESEARCH_TIMEOUT_MS=20000

# Optional advanced PDF extraction sidecar. Leave empty unless the sidecar is
# running. For local Docker with --profile pdf use http://localhost:8790/extract.
# Auto mode uses native text extraction first, then falls back to this sidecar
# only when native text is sparse/broken.
MNEMIS_PDF_EXTRACTOR_URL=
MNEMIS_PDF_EXTRACTOR_TIMEOUT_MS=180000
MNEMIS_PDF_NATIVE_MIN_CHARS=1500

# PDF sidecar runtime. Used when running docker compose with --profile pdf.
PDF_EXTRACTOR_MAX_BYTES=52428800
PDF_EXTRACTOR_ENABLE_GROBID=true
PDF_EXTRACTOR_GROBID_URL=http://grobid:8070
PDF_EXTRACTOR_GROBID_TIMEOUT_SECONDS=120
# Use grobid/grobid:0.9.0-full for highest accuracy if you can afford the RAM/GPU.
GROBID_IMAGE=grobid/grobid:0.9.0-crf

# Reserved for future reranking integrations.
COHERE_API_KEY=

# --- Internal auth (used to derive API key hashes) ---
# Rotate this before production. Changing it invalidates existing API keys.
INTERNAL_AUTH_SECRET=change-me-in-production

# --- Self-host vs cloud mode ---
MNEMIS_MODE=self-host

# Disabled by default because it lets API users ask the worker to read local
# paths from the server filesystem. Enable only for trusted local development.
MNEMIS_ALLOW_LOCAL_SOURCES=false
MNEMIS_LOCAL_SOURCE_ROOTS=

# --- API guardrails ---
MNEMIS_MAX_BODY_BYTES=1000000
MNEMIS_RATE_LIMIT_PER_MINUTE=
MNEMIS_RATE_LIMIT_BACKEND=
MNEMIS_TRUST_PROXY=false

# --- Worker reliability ---
WORKER_POLL_INTERVAL_MS=1000
WORKER_ONCE=false
JOB_STALE_AFTER_MS=1800000
JOB_MAX_ATTEMPTS=3
